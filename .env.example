# First milestone: local development only. No external service accounts required.
# Browser development uses Vite's /api proxy; leave VITE_API_URL empty.
VITE_API_URL=
# For a packaged Android app this must be your deployed HTTPS backend URL.
# VITE_API_URL=https://your-smartshop-backend.example
# For phone live development, set CAPACITOR_DEV_SERVER_URL in the terminal
# to your Mac's LAN Vite URL before `npm run android:sync`.
