# First milestone: local development only. No external service accounts required.
# Browser development uses Vite's /api proxy; leave VITE_API_URL empty.
VITE_API_URL=
# Firebase public app configuration, copied from your own Firebase project.
# These identify the client project; private service-account keys never belong here as literal JSON.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
# Set true only after Phone Auth/SMS regions and billing are enabled in Firebase.
FIREBASE_PHONE_ENABLED=false
# Free local pictures live under .data/uploads. Optional remote providers: firebase or cloudinary.
STORAGE_PROVIDER=local
# For Firebase uploads, a LOCAL path to your downloaded private service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative image-storage provider (signed uploads happen on the server).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# For a packaged Android app this must be your deployed HTTPS backend URL.
# VITE_API_URL=https://your-smartshop-backend.example
# For phone live development, set CAPACITOR_DEV_SERVER_URL in the terminal
# to your Mac's LAN Vite URL before `npm run android:sync`.
